{
  "name": "time-management",
  "version": "1.0.0",
  "author": {
    "name": "MD. Alif Khan",
    "email": "mdalifk2002@gmail.com"
  },
  "main": "index.js",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "expo": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "electron": "electron ./electron/main.js",
    "electron:dev": "concurrently -k -s first \"npm run web\" \"wait-on tcp:8081 && electron ./electron/main.js\"",
    "clean:win": "node -e \"const fs=require('fs'); ['release/win-unpacked','release/win-unpacked.tmp'].forEach(p => fs.rmSync(p, {recursive:true, force:true}))\"",
    "build:web": "expo export --platform web",
    "build:win": "npm run clean:win && npm run build:web && electron-builder --win",
    "build:portable": "npm run clean:win && npm run build:web && electron-builder --win portable",
    "build:linux": "npm run clean:win && npm run build:web && electron-builder --linux",
    "build:android": "powershell -Command \"cd android; .\\gradlew.bat assembleRelease; cd ..; Copy-Item android\\app\\build\\outputs\\apk\\release\\app-release.apk release\\Time-Management.apk -Force\""
  },
  "build": {
    "appId": "com.timemanagement.app",
    "productName": "Time Management",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!**/node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.js",
      "dependencies": {}
    },
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "tar.gz",
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    }
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.1.0"
  }
}
