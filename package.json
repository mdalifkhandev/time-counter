{
  "name": "time-management",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "expo": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "electron": "electron ./electron/main.js",
    "electron:dev": "concurrently -k -s first \"npm run web\" \"wait-on tcp:8081 && electron ./electron/main.js\"",
    "build:web": "expo export --platform web",
    "build:win": "npm run build:web && electron-builder --win",
    "build:portable": "npm run build:web && electron-builder --win portable"
  },
  "build": {
    "appId": "com.timemanagement.app",
    "productName": "Time Management",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.1.0"
  }
}
